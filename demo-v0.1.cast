[182.054355, "o", "# Show help\r\r\npython -m src.cli --help\u001b[K\r\r\n\u001b[K\r\r\n# Scan with verbose output\u001b[K\r\r\npython -m src.cli scan --target <target> --verbose\u001b[K\r\r\n\u001b[K\r\r\n# Scan specific security categories\u001b[K\r\r\npython -m src.cli scan --target <target> --categories misconfigurations,prompt_injection\u001b[K\r\r\n\u001b[K\r\r\n# Set log level\u001b[K\r\r\npython -m src.cli scan --target <target> --log-level DEBUG\u001b[K"]
[182.091968, "o", "\u001b[10A\u001b[54D\u001b[1m\u001b[30m#\u001b[1m\u001b[30m \u001b[1m\u001b[30mS\u001b[1m\u001b[30mh\u001b[1m\u001b[30mo\u001b[1m\u001b[30mw\u001b[1m\u001b[30m \u001b[1m\u001b[30mh\u001b[1m\u001b[30me\u001b[1m\u001b[30ml\u001b[1m\u001b[30mp\u001b[0m\u001b[39m\u001b[1B\r\u001b[36mp\u001b[36my\u001b[36mt\u001b[36mh\u001b[36mo\u001b[36mn\u001b[39m \u001b[32m-\u001b[32mm\u001b[39m\u001b[9C\u001b[32m-\u001b[32m-\u001b[32mh\u001b[32me\u001b[32ml\u001b[32mp\u001b[39m\u001b[2B\r\u001b[1m\u001b[30m#\u001b[1m\u001b[30m \u001b[1m\u001b[30mS\u001b[1m\u001b[30mc\u001b[1m\u001b[30ma\u001b[1m\u001b[30mn\u001b[1m\u001b[30m \u001b[1m\u001b[30mw\u001b[1m\u001b[30mi\u001b[1m\u001b[30mt\u001b[1m\u001b[30mh\u001b[1m\u001b[30m \u001b[1m\u001b[30mv\u001b[1m\u001b[30me\u001b[1m\u001b[30mr\u001b[1m\u001b[30mb\u001b[1m\u001b[30mo\u001b[1m\u001b[30ms\u001b[1m\u001b[30me\u001b[1m\u001b[30m \u001b[1m\u001b[30mo\u001b[1m\u001b[30mu\u001b[1m\u001b[30mt\u001b[1m\u001b[30mp\u001b[1m\u001b[30mu\u001b[1m\u001b[30mt\u001b[0m\u001b[39m\u001b[1B\r\u001b[36mp\u001b[36my\u001b[36mt\u001b[36mh\u001b[36mo\u001b[36mn\u001b[39m \u001b[32m-\u001b[32mm\u001b[39m\u001b[14C\u001b[32m-\u001b[32m-\u001b[32mt\u001b[32ma\u001b[32mr\u001b[32mg\u001b[32me\u001b[32mt\u001b[39m \u001b[1m\u001b[34m<\u001b[0m\u001b[39m\u001b[6C\u001b[1m\u001b[34m>\u001b[0m\u001b[39m\u001b[2B\r\u001b[1m\u001b[30m#\u001b[1m\u001b[30m \u001b[1m\u001b[30mS\u001b[1m\u001b[30mc\u001b[1m\u001b[30ma\u001b[1m\u001b[30mn\u001b[1m\u001b[30m \u001b[1m\u001b[30ms\u001b[1m\u001b[30mp\u001b[1m\u001b[30me\u001b[1m\u001b[30mc\u001b[1m\u001b[30mi\u001b[1m\u001b[30mf\u001b[1m\u001b[30mi\u001b[1m\u001b[30mc\u001b[1m\u001b[30m \u001b[1m\u001b[30ms\u001b[1m\u001b[30me\u001b[1m\u001b[30mc\u001b[1m\u001b[30mu\u001b[1m\u001b[30mr\u001b[1m\u001b[30mi\u001b[1m\u001b[30mt\u001b[1m\u001b[30my\u001b[1m\u001b[30m \u001b[1m\u001b[30mc\u001b[1m\u001b[30ma\u001b[1m\u001b[30mt\u001b[1m\u001b[30me\u001b[1m\u001b[30mg\u001b[1m\u001b[30mo\u001b[1m\u001b[30mr